# ===========================================================================
# Urology Intelligence — Environment configuration
# Copy to ".env" and fill in real secrets. NEVER commit ".env".
# ===========================================================================

# --- Application ---
APP_ENV=production
LOG_LEVEL=INFO
TIMEZONE=America/Sao_Paulo

# --- LLM providers ---------------------------------------------------------
# OpenAI é OPCIONAL: usado só para embeddings/RAG (busca semântica). Deixe vazio
# para rodar só com Claude — o RAG fica desativado e a newsletter funciona normal.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Model selection (override defaults if desired)
# Current Claude models (2026). Triagem barata no Haiku; análise/redação no Sonnet.
# Para a melhor qualidade de escrita, troque NEWSLETTER_MODEL por claude-opus-5-5.
TRIAGE_MODEL=claude-haiku-5-5
ANALYSIS_MODEL=claude-sonnet-5-5
APPRAISAL_MODEL=claude-sonnet-5-5
NEWSLETTER_MODEL=claude-sonnet-5-5
# Embeddings (RAG) requer OpenAI. Sem OPENAI_API_KEY, o RAG fica desativado e o
# resto do pipeline (newsletter) funciona normalmente só com o Claude.
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=3072

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=urology
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=urology
# Used by the app container (overridden in docker-compose); for local runs:
DATABASE_URL=postgresql+psycopg2://urology:change-me-strong-password@localhost:5432/urology

# --- Qdrant ----------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=urology_knowledge

# --- Redis -----------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- External scientific APIs ---------------------------------------------
# PubMed / NCBI E-utilities (an API key raises the rate limit to 10 req/s)
NCBI_API_KEY=
NCBI_EMAIL=matheusmenezesurologia@gmail.com
NCBI_TOOL=urology-intelligence

# CrossRef polite pool (providing a mailto improves reliability)
CROSSREF_MAILTO=matheusmenezesurologia@gmail.com

# Semantic Scholar (optional key raises rate limits)
SEMANTIC_SCHOLAR_API_KEY=

# OpenAlex polite pool
OPENALEX_MAILTO=matheusmenezesurologia@gmail.com

# Unpaywall (open-access PDF resolution)
UNPAYWALL_EMAIL=matheusmenezesurologia@gmail.com

# --- Delivery channel ------------------------------------------------------
# How the weekly newsletter is delivered: email | whatsapp | both
DELIVERY_CHANNEL=email

# --- Email (SMTP) — default channel ---------------------------------------
# Recomendado: uma conta Gmail DEDICADA só para enviar (não a sua pessoal).
# Na conta REMETENTE: ative a verificação em 2 etapas e gere uma "App password"
# em https://myaccount.google.com/apppasswords e cole os 16 caracteres abaixo.
# (Não use comentários na mesma linha dos valores: deixe-os em linhas próprias.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# SMTP_USER: a conta que ENVIA (autentica no Gmail)
SMTP_USER=seu-remetente-dedicado@gmail.com
# SMTP_PASSWORD: a app password DA conta remetente
SMTP_PASSWORD=your-16-char-gmail-app-password
# EMAIL_FROM: deixe vazio para usar o SMTP_USER
EMAIL_FROM=
# EMAIL_TO: quem RECEBE (seu email pessoal)
EMAIL_TO=matheusmenezesurologia@gmail.com

# --- WhatsApp (Meta Cloud API) — optional secondary channel ---------------
# Só é usado se DELIVERY_CHANNEL incluir "whatsapp".
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-permanent-access-token
# Destinatário em E.164 sem o "+" (ex.: 5511999999999)
WHATSAPP_RECIPIENT=5511999999999
# Nome de um template pré-aprovado (opcional)
WHATSAPP_TEMPLATE_NAME=

# --- Scheduler -------------------------------------------------------------
# Weekly run: Friday 18:00 America/Sao_Paulo
PIPELINE_CRON_DAY_OF_WEEK=fri
PIPELINE_CRON_HOUR=18
PIPELINE_CRON_MINUTE=0

# --- Pipeline tuning -------------------------------------------------------
LOOKBACK_DAYS=7
TOP_N_ARTICLES=10
TRIAGE_RELEVANCE_THRESHOLD=55
MAX_CONCURRENT_LLM=4
HTTP_TIMEOUT_SECONDS=45
HTTP_MAX_RETRIES=4

# --- Grafana ---------------------------------------------------------------
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
